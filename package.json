{
  "name": "after-hours-movie-archive",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "nuxt build",
    "build:lambda": "nuxt build --preset aws-lambda",
    "dev": "nuxt dev",
    "generate:static": "node scripts/generate-static.mjs",
    "preview": "nuxt preview",
    "auth:setup": "node scripts/setup-auth.mjs",
