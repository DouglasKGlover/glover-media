    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@aws-sdk/client-eventbridge": "^3.1156.0",
    "@aws-sdk/lib-dynamodb": "^3.1156.0",
    "@tailwindcss/vite": "4.3.3",
    "better-sqlite3": "13.0.3",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "nuxt": "4.6.2",
    "tailwindcss": "4.3.3",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.13"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": true
